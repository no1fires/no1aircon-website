---
import { addressLine, business, openingHoursText } from '../data/business.js';
import { services } from '../data/services.js';
import { towns } from '../data/towns.js';

const year = new Date().getFullYear();
const whatsappText = "Hi No1 Air Con, I'd like to ask about air conditioning.";
const whatsappHref = business.whatsappIntl
  ? `https://wa.me/${String(business.whatsappIntl).replace('+', '')}?text=${encodeURIComponent(whatsappText)}`
  : '';
const featuredSlugs = ['ringwood', 'ferndown', 'christchurch', 'wimborne'];
const featuredTowns = featuredSlugs.map((slug) => towns.find((town) => town.slug === slug)).filter(Boolean);
const moreTowns = towns.filter((town) => !featuredSlugs.includes(town.slug));
const socials = [
  business.facebook && { name: 'Facebook', href: business.facebook },
  business.instagram && { name: 'Instagram', href: business.instagram },
].filter(Boolean);
---
<footer class="footer">
  <div class="container footer-grid">
    <div>
      <img class="footer-logo" src="/images/no1-aircon-logo-white.svg" alt={business.name} width="176" height="44" />
      <p>Air conditioning installation, servicing and repairs for homes and businesses, from our showroom in Ringwood.</p>
      <p class="footer-address">{addressLine()}</p>
      <p class="footer-hours">Opening hours: {openingHoursText()}.</p>
      {socials.length > 0 && (
        <div class="footer-social">
          {socials.map((item) => (
            <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.name}>
              {item.name === 'Facebook' ? (
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.5 8.5V6.8c0-.7.5-1 1.2-1H17V3h-2.1C12.2 3 11 4.4 11 6.6v1.9H9v2.7h2V21h3.5v-9.8h2.3l.4-2.7h-2.7z"/></svg>
              ) : (
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/></svg>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
    <div>
      <h2>Services</h2>
      <ul>
        {services.map((service) => (
          <li><a href={`/services/${service.slug}/`}>{service.name}</a></li>
        ))}
        <li><a class="view-all" href="/services/">View all services</a></li>
      </ul>
    </div>
    <div>
      <h2>Areas</h2>
      <ul>
        {featuredTowns.map((town) => (
          <li><a href={`/areas/${town.slug}/`}>{town.name}</a></li>
        ))}
        {moreTowns.length > 0 && (
          <li>
            <details class="footer-more">
              <summary>More areas</summary>
              <ul>
                {moreTowns.map((town) => (
                  <li><a href={`/areas/${town.slug}/`}>{town.name}</a></li>
                ))}
              </ul>
            </details>
          </li>
        )}
        <li><a class="view-all" href="/areas/">View all areas</a></li>
      </ul>
    </div>
    <div>
      <h2>Company</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/about/#showroom">Showroom</a></li>
        <li><a href="/reviews/">Reviews</a></li>
        <li><a href="/faqs/">FAQs</a></li>
        <li><a href="/case-studies/">Case studies</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href={`tel:${business.phoneIntl}`}>{business.phone}</a></li>
        {whatsappHref && <li><a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp us</a></li>}
        <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
      </ul>
    </div>
    <div>
      <h2>NO1 Energy Solutions Group</h2>
      <ul>
        <li>No1 Trade Experts</li>
        <li><a href="https://www.gasandelectricfireplaces.co.uk" target="_blank" rel="noopener noreferrer">No1 Fires</a></li>
        <li>No1 Logs</li>
        <li><a href="https://no1sweeps.co.uk" target="_blank" rel="noopener noreferrer">No1 Sweeps</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer-base">
    <p>© {year} {business.legalName}, trading as {business.name}.</p>
    <p>
      <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/cookies/">Cookies</a>
    </p>
  </div>
  <div class="container">
    <p class="footer-reg">NO1 Energy Solutions Ltd, trading as No1 Air Con. Registered in England and Wales, company no. {business.companyNumber}.</p>
  </div>
</footer>

<style>
  .footer-reg {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }
</style>
