---
import { business } from '../data/business.js';
import { services } from '../data/services.js';
import { towns } from '../data/towns.js';

const year = new Date().getFullYear();
const whatsappText = "Hi No1 Air Con, I'd like to ask about air conditioning.";
const whatsappHref = business.whatsappIntl
  ? `https://wa.me/${String(business.whatsappIntl).replace('+', '')}?text=${encodeURIComponent(whatsappText)}`
  : '';
const featuredSlugs = ['ringwood', 'ferndown', 'christchurch', 'wimborne'];
const featuredTowns = featuredSlugs.map((slug) => towns.find((town) => town.slug === slug)).filter(Boolean);
const moreTowns = towns.filter((town) => !featuredSlugs.includes(town.slug));
const socials = [
  business.facebook && { name: 'Facebook', href: business.facebook },
  business.instagram && { name: 'Instagram', href: business.instagram },
].filter(Boolean);
const group = [
  { name: 'No1 Trade Experts', href: 'https://no1tradeexperts.co.uk' },
  { name: 'No1 Fires', href: 'https://www.gasandelectricfireplaces.co.uk' },
  { name: 'No1 Logs', href: 'https://no1logs.co.uk' },
  { name: 'No1 Sweeps', href: 'https://no1sweeps.co.uk' },
];
---
<footer class="footer">
  <div class="container">
    <div class="contact-strip">
      <div class="strip-cell">
        <svg class="visit-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <div>
          <h2>Visit us</h2>
          <p>{business.street}<br />{business.town}, {business.county}<br />{business.postcode}</p>
        </div>
      </div>
      <div class="strip-cell">
        <svg class="visit-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3.5h3.2l1.2 3-2 .9a12.5 12.5 0 0 0 5.7 5.7l.9-2 3 1.2V16a1.5 1.5 0 0 1-1.6 1.5A14.5 14.5 0 0 1 4.5 5.1 1.5 1.5 0 0 1 6 3.5Z" fill="none" stroke="currentColor" stroke-width="1.8"/></svg>
        <div>
          <h2>Call</h2>
          <p><a href={`tel:${business.phoneIntl}`}>{business.phone}</a></p>
        </div>
      </div>
      <div class="strip-cell">
        <svg class="visit-icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.15 6.4 2.15 11.83c0 1.74.46 3.44 1.34 4.94L2 22l5.39-1.41a10.1 10.1 0 0 0 4.65 1.14h.01c5.46 0 9.89-4.4 9.89-9.83C21.94 6.4 17.5 2 12.04 2zm5.76 13.84c-.24.68-1.4 1.3-1.94 1.38-.5.08-1.12.11-1.81-.11-.42-.14-.95-.31-1.64-.6-2.88-1.24-4.76-4.14-4.9-4.33-.14-.19-1.16-1.54-1.16-2.94s.73-2.08 1-2.37c.26-.28.57-.35.76-.35h.55c.17 0 .41-.07.64.49.24.58.81 2 .88 2.14.07.15.12.32.02.51-.09.19-.14.31-.28.48-.14.16-.29.36-.42.49-.14.14-.28.29-.12.56.16.28.7 1.16 1.51 1.88 1.04.92 1.91 1.21 2.19 1.35.28.14.44.12.6-.07.16-.19.69-.8.87-1.08.19-.27.37-.23.62-.14.26.09 1.62.76 1.9.9.28.14.46.21.53.32.07.12.07.68-.17 1.36z"/></svg>
        <div>
          <h2>Message</h2>
          <p>
            {whatsappHref && <><a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp us</a><br /></>}
            <a href={`mailto:${business.email}`}>{business.email}</a>
          </p>
        </div>
      </div>
      <div class="strip-cell">
        <svg class="visit-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v4.5l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <div>
          <h2>Opening hours</h2>
          <p>Tuesday to Saturday, 10am to 4pm.<br />Closed Sunday and Monday.</p>
        </div>
      </div>
    </div>
    <div class="footer-grid">
      <div>
        <img class="footer-logo" src="/images/no1-aircon-logo-white.svg" alt={business.name} width="176" height="44" />
        <p>Air conditioning installation, servicing and repairs for homes and businesses, from our showroom in Ringwood.</p>
        {socials.length > 0 && (
          <div class="footer-social">
            {socials.map((item) => (
              <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.name}>
                {item.name === 'Facebook' ? (
                  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M14.5 8.5V6.8c0-.7.5-1 1.2-1H17V3h-2.1C12.2 3 11 4.4 11 6.6v1.9H9v2.7h2V21h3.5v-9.8h2.3l.4-2.7h-2.7z"/></svg>
                ) : (
                  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.6" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/></svg>
                )}
              </a>
            ))}
          </div>
        )}
      </div>
      <div>
        <h2>Services</h2>
        <ul>
          {services.map((service) => (
            <li><a href={`/services/${service.slug}/`}>{service.name}</a></li>
          ))}
          <li><a class="view-all" href="/services/">View all services</a></li>
        </ul>
      </div>
      <div>
        <h2>Areas</h2>
        <ul>
          {featuredTowns.map((town) => (
            <li><a href={`/areas/${town.slug}/`}>{town.name}</a></li>
          ))}
          {moreTowns.length > 0 && (
            <li>
              <details class="footer-more">
                <summary>More areas</summary>
                <ul>
                  {moreTowns.map((town) => (
                    <li><a href={`/areas/${town.slug}/`}>{town.name}</a></li>
                  ))}
                </ul>
              </details>
            </li>
          )}
          <li><a class="view-all" href="/areas/">View all areas</a></li>
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          <li><a href="/case-studies/">Case studies</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/about/#showroom">Showroom</a></li>
          <li><a href="/reviews/">Reviews</a></li>
          <li><a href="/faqs/">FAQs</a></li>
          <li><a href="/air-conditioning-cost/">Air conditioning cost</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>
      <div>
        <h2>NO1 Energy Solutions Group</h2>
        <ul>
          {group.map((item) => (
            <li><a href={item.href} target="_blank" rel="noopener noreferrer">{item.name}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
  <div class="container footer-base">
    <p>© {year} {business.legalName}, trading as {business.name}.</p>
    <p>
      <a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a> · <a href="/cookies/">Cookies</a>
    </p>
  </div>
  <div class="container">
    <p class="footer-reg">NO1 Energy Solutions Ltd, trading as No1 Air Con. Registered in England and Wales, company no. {business.companyNumber}.</p>
  </div>
</footer>

<style>
  .footer-reg {
    margin: 12px 0 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
  }
  .footer-grid > div,
  .strip-cell,
  .strip-cell div { min-width: 0; }
  .visit-icon {
    width: 18px;
    height: 18px;
    flex: none;
    margin-top: 3px;
    color: var(--orange);
  }
  .strip-cell p { margin: 0; line-height: 1.45; overflow-wrap: anywhere; }
  .contact-strip {
    display: grid;
    gap: 22px;
    margin-bottom: 28px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .strip-cell { display: flex; gap: 12px; align-items: flex-start; min-width: 0; }
  .strip-cell h2 { margin-bottom: 6px; }
  @media (min-width: 640px) {
    .contact-strip { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .contact-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  }
</style>
