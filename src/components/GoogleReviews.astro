---
import reviews from '../data/google-reviews.json';
import { business } from '../data/business.js';

const mapsUrl = 'https://maps.google.com/?cid=4600408711547603359';
const writeUrl = 'https://search.google.com/local/writereview?placeid=ChIJky9kwfeXc0gRn0loYVnv1z8';
const ratingValue = business.rating?.value || '5.0';
const reviewCount = reviews.length;
const palette = ['#0f1e3d', '#174ca1', '#c24e12', '#1a3058'];

function initial(name) {
  return name.trim().charAt(0).toUpperCase();
}

function avatarColor(name) {
  const code = name.trim().charCodeAt(0) || 0;
  return palette[code % palette.length];
}
---
<section class="section reviews-band" id="reviews" data-google-reviews>
  <div class="container">
    <header class="g-head">
      <div class="g-brand">
        <svg class="g-logo" viewBox="0 0 24 24" width="36" height="36" aria-hidden="true">
          <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5c-.3 1.5-1.1 2.8-2.4 3.6v3h3.9c2.3-2.1 3.5-5.2 3.5-8.7z"/>
          <path fill="#34A853" d="M12 24c3.2 0 5.9-1.1 7.9-2.9l-3.9-3c-1.1.7-2.4 1.2-4 1.2-3.1 0-5.7-2.1-6.6-4.9H1.4v3.1C3.4 21.3 7.4 24 12 24z"/>
          <path fill="#FBBC05" d="M5.4 14.4c-.2-.7-.4-1.5-.4-2.4s.1-1.7.4-2.4V6.5H1.4C.5 8.3 0 10.1 0 12s.5 3.7 1.4 5.5l4-3.1z"/>
          <path fill="#EA4335" d="M12 4.8c1.7 0 3.3.6 4.5 1.8l3.4-3.4C17.9 1.2 15.2 0 12 0 7.4 0 3.4 2.7 1.4 6.5l4 3.1C6.3 6.8 8.9 4.8 12 4.8z"/>
        </svg>
        <div>
          <h2>
            <span class="g-score">{ratingValue}</span>
            <span class="stars" aria-hidden="true">★★★★★</span>
            <span class="visually-hidden"> out of 5</span>
          </h2>
          <p>from {reviewCount} Google reviews</p>
        </div>
      </div>
      <div class="g-actions">
        <a class="btn" href={mapsUrl} target="_blank" rel="noopener noreferrer">Read all reviews on Google</a>
        <a class="btn btn-navy" href={writeUrl} target="_blank" rel="noopener noreferrer">Leave us a review</a>
      </div>
    </header>

    <div class="review-nav">
      <button type="button" data-reviews-prev aria-label="Previous reviews">‹</button>
      <button type="button" data-reviews-next aria-label="Next reviews">›</button>
    </div>

    <div class="review-track" tabindex="0" aria-label="Google reviews">
      {reviews.map((review) => (
        <article class="review-card">
          <header>
            <span class="avatar" style={`background:${avatarColor(review.name)}`} aria-hidden="true">{initial(review.name)}</span>
            <span>
              <strong>{review.name}</strong>
              <span class="stars" aria-label={`${review.stars} out of 5 stars`}>★★★★★</span>
            </span>
          </header>
          <p class="review-text">{review.text}</p>
          <button type="button" class="review-more" aria-expanded="false">Read more</button>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('[data-google-reviews]').forEach((root) => {
    root.querySelectorAll('.review-card').forEach((card) => {
      const text = card.querySelector('.review-text');
      const button = card.querySelector('.review-more');
      if (!text || !button) return;
      if (text.scrollHeight <= text.clientHeight + 1) {
        button.hidden = true;
        return;
      }
      button.addEventListener('click', () => {
        const open = text.classList.toggle('is-open');
        button.textContent = open ? 'Show less' : 'Read more';
        button.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    });

    const track = root.querySelector('.review-track');
    const step = () => Math.max((track?.clientWidth || 280) * 0.86, 240);
    root.querySelector('[data-reviews-prev]')?.addEventListener('click', () => {
      track?.scrollBy({ left: -step(), behavior: 'smooth' });
    });
    root.querySelector('[data-reviews-next]')?.addEventListener('click', () => {
      track?.scrollBy({ left: step(), behavior: 'smooth' });
    });
  });
</script>

<style>
  .reviews-band { background: var(--off-white); }
  .g-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px 24px;
    margin-bottom: 18px;
  }
  .g-brand { display: flex; align-items: center; gap: 14px; }
  .g-logo { flex: none; }
  .g-head h2 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    letter-spacing: -0.03em;
  }
  .g-score { font-weight: 800; }
  .g-head p { margin: 0; color: var(--muted); font-weight: 700; }
  .stars { color: #f4b400; letter-spacing: 1px; font-size: 1rem; line-height: 1; }
  .g-head .stars { font-size: 1.15rem; }
  .g-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .review-nav { display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 12px; }
  .review-nav button {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--navy);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .review-nav button:hover { border-color: var(--navy); }
  .review-track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 2px;
    padding-bottom: 6px;
  }
  .review-card {
    flex: 0 0 min(86%, 22rem);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 100%;
    padding: 22px 20px 18px;
    background: #fff;
    border-radius: 24px;
    border-top: 5px solid var(--orange);
    box-shadow: 0 14px 32px rgba(15, 30, 61, 0.08);
  }
  .review-card header { display: flex; align-items: center; gap: 12px; }
  .review-card strong { display: block; color: var(--navy); line-height: 1.2; }
  .review-card header .stars { display: block; margin-top: 4px; }
  .avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 999px;
    color: #fff;
    font-weight: 800;
    font-size: 1.05rem;
  }
  .review-text {
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin: 0;
    color: var(--muted);
    white-space: pre-line;
  }
  .review-text.is-open {
    display: block;
    -webkit-line-clamp: unset;
    overflow: visible;
  }
  .review-more {
    align-self: flex-start;
    margin-top: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--blue);
    font-family: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .review-more:hover { color: var(--blue-hover); }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (min-width: 900px) {
    .review-nav { display: none; }
    .review-track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      scroll-snap-type: none;
    }
    .review-card { flex: none; }
  }
</style>
