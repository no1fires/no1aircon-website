---
import { business } from '../data/business.js';
import { services } from '../data/services.js';
import { towns } from '../data/towns.js';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
const current = (href) => (path === href ? 'page' : undefined);
---
<header id="site-header" class="site-header">
  <div class="header-top">
    <div class="container header-top-in">
      <a class="logo" href="/" aria-label={`${business.name} home`}>
        <img src="/images/no1-aircon-logo.svg" alt="" width="184" height="46" />
      </a>
      <div class="header-actions">
        <a class="header-phone" href={`tel:${business.phoneIntl}`}>
          <Icon name="phone" size={20} />
          {business.phone}
        </a>
        <a class="btn header-quote" href="#quote">Get a free quote</a>
        <a class="icon-btn header-call" href={`tel:${business.phoneIntl}`} aria-label={`Call ${business.phone}`}>
          <Icon name="phone" size={20} />
        </a>
        <button class="menu-btn" type="button" data-menu-button aria-expanded="false" aria-controls="mobile-menu" aria-label="Open menu">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </div>
  <div class="header-nav">
    <div class="container">
      <nav class="nav" aria-label="Main">
        <div class="nav-item">
          <a class="nav-link" href="/services/" aria-current={path.startsWith('/services/') ? 'page' : undefined}>
            Services <Icon name="chevron" size={16} />
          </a>
          <div class="nav-sub">
            {services.map((service) => (
              <a href={`/services/${service.slug}/`} aria-current={current(`/services/${service.slug}/`)}>{service.nav}</a>
            ))}
            <a href="/services/">All services</a>
          </div>
        </div>
        <div class="nav-item">
          <a class="nav-link" href="/areas/" aria-current={path.startsWith('/areas/') ? 'page' : undefined}>
            Areas <Icon name="chevron" size={16} />
          </a>
          <div class="nav-sub">
            {towns.map((town) => (
              <a href={`/areas/${town.slug}/`} aria-current={current(`/areas/${town.slug}/`)}>{town.name}</a>
            ))}
            <a href="/areas/">All areas</a>
          </div>
        </div>
        <a class="nav-link" href="/about/" aria-current={current('/about/')}>About</a>
        <a class="nav-link" href="/about/#showroom">Showroom</a>
        <a class="nav-link" href="/reviews/" aria-current={current('/reviews/')}>Reviews</a>
        <a class="nav-link" href="/contact/" aria-current={current('/contact/')}>Contact</a>
      </nav>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" data-mobile-menu aria-hidden="true" inert>
  <nav aria-label="Mobile">
    <a class="mobile-link" href="/" aria-current={current('/')}>Home</a>
    <button class="sub-toggle" type="button" data-sub-toggle aria-expanded="false" aria-controls="mobile-services">
      Services <Icon name="chevron" size={18} />
    </button>
    <div id="mobile-services" class="mobile-sub" hidden>
      {services.map((service) => <a href={`/services/${service.slug}/`}>{service.nav}</a>)}
      <a href="/services/">All services</a>
    </div>
    <button class="sub-toggle" type="button" data-sub-toggle aria-expanded="false" aria-controls="mobile-areas">
      Areas <Icon name="chevron" size={18} />
    </button>
    <div id="mobile-areas" class="mobile-sub" hidden>
      {towns.map((town) => <a href={`/areas/${town.slug}/`}>{town.name}</a>)}
      <a href="/areas/">All areas</a>
    </div>
    <a class="mobile-link" href="/about/" aria-current={current('/about/')}>About</a>
    <a class="mobile-link" href="/about/#showroom">Showroom</a>
    <a class="mobile-link" href="/reviews/" aria-current={current('/reviews/')}>Reviews</a>
    <a class="mobile-link" href="/contact/" aria-current={current('/contact/')}>Contact</a>
    <a class="mobile-link" href="/faqs/">FAQs</a>
    <div class="mobile-contact">
      <a href={`tel:${business.phoneIntl}`}>Call {business.phone}</a>
      <a href={`mailto:${business.email}`}>{business.email}</a>
      <a class="btn" href="#quote">Get a free quote</a>
    </div>
  </nav>
</div>
