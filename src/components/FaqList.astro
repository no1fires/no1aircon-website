---
import Icon from './Icon.astro';
import RichText from './RichText.astro';
const { faqs = [], heading = 'Questions we get asked', headingId = 'faq-heading', showHead = true } = Astro.props;
---
{faqs.length > 0 && (
  <section class="section" aria-labelledby={showHead ? headingId : undefined} aria-label={showHead ? undefined : heading}>
    <div class="container">
      {showHead && (
        <div class="section-head center">
          <p class="eyebrow">FAQs</p>
          <h2 id={headingId}>{heading}</h2>
        </div>
      )}
      <div class="faq-grid">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>
              {faq.q}
              <span class="faq-toggle"><Icon name="chevron" size={16} /></span>
            </summary>
            <div class="faq-answer">
              {faq.paragraphs ? faq.paragraphs.map((paragraph) => <p><RichText text={paragraph} /></p>) : <p><RichText text={faq.a} /></p>}
              {faq.sources?.length > 0 && (
                <p class="faq-sources">
                  Sources:{' '}
                  {faq.sources.map((source, index) => (
                    <span>
                      {index > 0 && '; '}
                      <a href={source.url} rel="noopener noreferrer">{source.name}</a>
                    </span>
                  ))}
                </p>
              )}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
