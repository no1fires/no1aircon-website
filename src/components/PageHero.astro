---
import { business } from '../data/business.js';
import Breadcrumbs from './Breadcrumbs.astro';
import LifestyleBand from './LifestyleBand.astro';
import RichText from './RichText.astro';

const { eyebrow, title, lead, crumbs = [], photo = null } = Astro.props;
---
<section class="page-hero">
  <div class="container page-hero-grid">
    <div class="page-hero-copy">
      {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
      {eyebrow && <p class="eyebrow eyebrow-on-dark">{eyebrow}</p>}
      <h1>{title}</h1>
      {lead && <p class="lead"><RichText text={lead} /></p>}
      <div class="hero-actions">
        <a class="btn" href="#quote">Get a free quote</a>
        <a class="btn btn-outline" href={`tel:${business.phoneIntl}`}>Call {business.phone}</a>
      </div>
    </div>
    {photo && <LifestyleBand photo={photo} />}
  </div>
</section>
