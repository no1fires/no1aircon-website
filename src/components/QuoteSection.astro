---
import { business } from '../data/business.js';

const { title = 'Tell us about the space', intro = 'A short note is enough. We will arrange a free survey and then send a fixed price. There is no obligation to go ahead.' } = Astro.props;
---
<section class="section tint" id="quote" aria-labelledby="quote-heading">
  <div class="container quote-grid">
    <div>
      <p class="eyebrow">Free quote</p>
      <h2 id="quote-heading">{title}</h2>
      <p class="lead">{intro}</p>
      <p>Prefer to talk now? Call <a href={`tel:${business.phoneIntl}`}><strong>{business.phone}</strong></a> or email <a href={`mailto:${business.email}`}>{business.email}</a>.</p>
      <p class="muted">{business.financeNote}</p>
    </div>
    <div class="quote-card">
      <iframe src="https://link.apisystem.tech/widget/form/roELVvgk9jhNB8MKlM1k" style="width:100%;height:900px;border:none;border-radius:3px" id="inline-roELVvgk9jhNB8MKlM1k" data-layout="{'id':'INLINE'}" data-trigger-type="alwaysShow" data-activation-type="alwaysActivated" data-deactivation-type="neverDeactivate" data-form-name="AC form" data-height="900" data-layout-iframe-id="inline-roELVvgk9jhNB8MKlM1k" data-form-id="roELVvgk9jhNB8MKlM1k" title="AC form"></iframe>
      <script src="https://link.apisystem.tech/js/form_embed.js"></script>
    </div>
  </div>
</section>
