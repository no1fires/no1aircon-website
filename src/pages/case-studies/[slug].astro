---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import { caseStudies, getCaseStudy } from '../../data/case-studies.js';
import { getService } from '../../data/services.js';

export function getStaticPaths() {
  return caseStudies.map((study) => ({ params: { slug: study.slug } }));
}

const study = getCaseStudy(Astro.params.slug);
const service = getService(study.service);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Case studies', href: '/case-studies/' },
  { name: study.name, href: `/case-studies/${study.slug}/` },
];
---
<Base title={study.title} description={study.description} crumbs={crumbs}>
  <PageHero eyebrow={study.eyebrow} title={study.h1} lead={study.lead} crumbs={crumbs} />
  <section class="section">
    <div class="container prose">
      <div class="todo-slot">
        <h2>Placeholder, not a real job</h2>
        <p>Do not treat the fields below as something that happened. They are blanks for Danny to replace.</p>
        <dl>
          {study.fields.map((field) => (
            <div style="margin-top:12px;">
              <dt><strong>{field.label}</strong></dt>
              <dd class="todo">{field.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      {study.explainer.map((paragraph) => <p>{paragraph}</p>)}
      {service && <p>The service this will illustrate is <a href={`/services/${service.slug}/`}>{service.name}</a>.</p>}
    </div>
  </section>
  <QuoteSection />
</Base>
