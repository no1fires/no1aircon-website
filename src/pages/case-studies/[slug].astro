---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import GuideSection from '../../components/GuideSection.astro';
import { getCaseStudy } from '../../data/case-studies.js';
import { getService } from '../../data/services.js';
import { casePhotos } from '../../data/lifestyle.js';
import RichText from '../../components/RichText.astro';

export function getStaticPaths() {
  // Unpublished entries are not real jobs. They are not routed, so the
  // placeholder URLs 404 instead of being reachable.
  return [];
}

const study = getCaseStudy(Astro.params.slug);
const service = getService(study.service);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Case studies', href: '/case-studies/' },
  { name: study.name, href: `/case-studies/${study.slug}/` },
];
---
<Base title={study.title} description={study.description} crumbs={crumbs} forceNoindex>
  <PageHero eyebrow={study.eyebrow} title={study.h1} lead={study.lead} crumbs={crumbs} photo={casePhotos[study.slug]} />
  <GuideSection />
  <section class="section">
    <div class="container prose">
      {study.explainer.map((paragraph) => <p><RichText text={paragraph} /></p>)}
      {service && <p>Read more about <a href={`/services/${service.slug}/`}>{service.name}</a>.</p>}
    </div>
  </section>
  <QuoteSection />
</Base>
