---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import GuideSection from '../../components/GuideSection.astro';
import { caseStudies } from '../../data/case-studies.js';
import { pagePhotos } from '../../data/lifestyle.js';

const published = caseStudies.filter((study) => study.published);
const title = 'Air Conditioning Case Studies | No1 Air Con';
const description = 'A chalet bungalow in Warsash, Southampton, fitted with two Daikin Sensira wall units in one day.';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Case studies', href: '/case-studies/' },
];
---
<Base title={title} description={description} crumbs={crumbs}>
  <PageHero
    eyebrow="Case studies"
    title="Air conditioning we have fitted"
    lead="Real jobs, with the town and the equipment named. The first is a chalet bungalow in Warsash, Southampton."
    crumbs={crumbs}
    photo={pagePhotos.caseStudies}
  />
  <GuideSection />
  <section class="section">
    <div class="container area-grid">
      {published.map((study) => (
        <a class="area-link" href={`/case-studies/${study.slug}/`}>
          {study.name}
          <span>{study.lead}</span>
        </a>
      ))}
    </div>
  </section>
  <QuoteSection />
</Base>
