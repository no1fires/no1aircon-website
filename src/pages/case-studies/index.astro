---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import GuideSection from '../../components/GuideSection.astro';
import { caseStudies } from '../../data/case-studies.js';
import { pagePhotos } from '../../data/lifestyle.js';

const title = 'Air Conditioning Case Studies | No1 Air Con';
const description = 'How a single-room, multi-room or commercial air conditioning job is planned. Ask us to see a recent install.';
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Case studies', href: '/case-studies/' },
];
---
<Base title={title} description={description} crumbs={crumbs} forceNoindex>
  <PageHero
    eyebrow="Case studies"
    title="How a job is planned"
    lead="Single-room, multi-room and commercial work, explained without naming a customer. Ask us if you want to see a recent install."
    crumbs={crumbs}
    photo={pagePhotos.caseStudies}
  />
  <GuideSection />
  <section class="section">
    <div class="container area-grid">
      {caseStudies.map((study) => (
        <a class="area-link" href={`/case-studies/${study.slug}/`}>
          {study.name}
          <span>{study.lead}</span>
        </a>
      ))}
    </div>
  </section>
  <QuoteSection />
</Base>
