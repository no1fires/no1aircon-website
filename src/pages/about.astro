---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { business, brands, openingHoursText } from '../data/business.js';
import { brandList } from '../lib/format.js';
import { pagePhotos } from '../data/lifestyle.js';

const title = 'About No1 Air Con | Ringwood Showroom';
const description = `No1 Air Conditioning is the trading name of ${business.legalName}. Visit the showroom at ${business.street}, ${business.town} ${business.postcode}, or call ${business.phone}.`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'About', href: '/about/' },
];
const mapSrc = `https://maps.google.com/maps?q=${encodeURIComponent(`${business.street}, ${business.town} ${business.postcode}`)}&z=16&output=embed`;
---
<Base title={title} description={description} crumbs={crumbs}>
  <PageHero
    eyebrow="About"
    title="A Ringwood company you can visit"
    lead={`${business.name} installs, services and repairs air conditioning and air-to-air heat pumps for homes and businesses within ${business.radiusMiles} miles of our Ringwood showroom.`}
    crumbs={crumbs}
    photo={pagePhotos.about}
  />
  <section class="section">
    <div class="container prose">
      <h2>Who we are</h2>
      <p>{business.name}, also called {business.shortName}, is the trading name of {business.legalName}. The same company trades as <a href={business.sister.url} rel="noopener noreferrer">{business.sister.name}</a>.</p>
      <p>The showroom and the phone number are how you reach us. We do not publish staff names until they are confirmed.</p>
      <p>Company number: {business.companyNumber}.{business.vatNumber ? ` VAT number: ${business.vatNumber}.` : ''}</p>
      <h2>What we do</h2>
      <p>Home air conditioning, heating and cooling, commercial systems, servicing, repairs, and ducted or ceiling systems where the building can take them. A single room is installed from {business.priceFrom} including VAT. {business.warranty}</p>
      <p>Brands we install: {brandList(brands)}. {brands.map((brand) => brand.note).join(' ')}</p>
      <p>Our engineers are F-Gas certified through REFCOM.</p>
    </div>
  </section>
  <section class="section tint" id="showroom">
    <div class="container split">
      <div>
        <p class="eyebrow">Showroom</p>
        <h2>10 Christchurch Road, Ringwood</h2>
        <p>Christchurch Road is in Ringwood, Hampshire. It is not the town of Christchurch. Come and compare {brandList(brands)} side by side, and listen to them, before you decide.</p>
        <p><strong>{business.street}, {business.town}, {business.county} {business.postcode}</strong></p>
        <p><a href={`tel:${business.phoneIntl}`}>{business.phone}</a><br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
        <p>Opening hours: {openingHoursText()}.</p>
        <img src="/images/showroom-shopfront.jpg" alt="The No1 Fires and No1 Air Conditioning showroom at 10 Christchurch Road, Ringwood" width="1200" height="800" loading="lazy" style="width:100%;height:auto;border-radius:8px;margin:8px 0;" />
        <p style="margin-top:16px;"><a class="btn" href="/contact/#quote">Book a visit</a></p>
      </div>
      <div class="map-wrap" data-map-wrap data-map-src={mapSrc}>
        <button class="btn" type="button" data-map-button>Show the showroom on a map</button>
      </div>
    </div>
  </section>
  <QuoteSection title="Book a survey or a showroom visit" />
</Base>
