---
import HomeAcFrame from '../../components/design-options/HomeAcFrame.astro';
import IntroNotes from '../../components/design-options/IntroNotes.astro';
import { business } from '../../data/business.js';

const rooms = [
  { title: 'Bedrooms', text: 'Rooms that stay hot overnight.' },
  { title: 'Living rooms', text: 'Large windows or a south-facing aspect.' },
  { title: 'Home offices', text: 'Used through the day.' },
  { title: 'Garden rooms', text: 'And conservatories that are too hot from May.' },
];
const whatsapp = `https://wa.me/${business.whatsappIntl}?text=${encodeURIComponent("Hi No1 Air Con, I'd like to ask about air conditioning.")}`;
---
<HomeAcFrame option="B" title="Option B · Home AC intro | No1">
  <section class="section opt-b" aria-label="Option B intro">
    <div class="container">
      <div class="panel">
        <img
          src="/images/installs/indoor-living-corner.webp"
          alt="White wall-mounted indoor air conditioner high on a beige living-room wall beside curtains"
          width="1050"
          height="1400"
        />
        <div>
          <h2>One room that will not stay comfortable</h2>
          <p>We size the unit for that room. A Clivet single room is from {business.priceFrom} (0% VAT). Multi-room systems are from {business.multiRoomFrom}.</p>
          <div class="rooms">
            {rooms.map((room) => (
              <article>
                <h3>{room.title}</h3>
                <p>{room.text}</p>
              </article>
            ))}
          </div>
          <div class="actions">
            <a class="btn" href="#quote">Get a free quote</a>
            <a class="btn btn-outline" href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp {business.whatsapp}</a>
          </div>
        </div>
      </div>
      <IntroNotes />
    </div>
  </section>
</HomeAcFrame>

<style>
  .panel {
    display: grid;
    gap: 22px;
    background: var(--blue);
    color: #fff;
    border-radius: 20px;
    padding: 18px;
  }
  .panel img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    object-position: center 68%;
    border-radius: 14px;
  }
  .panel h2 { color: #fff; font-size: clamp(1.55rem, 3vw, 2.1rem); margin-bottom: 8px; }
  .panel > div > p { color: #fff; margin: 0 0 16px; }
  .rooms { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .rooms article { background: #fff; color: var(--navy); border-radius: 12px; padding: 14px; }
  .rooms h3 { font-size: 1rem; margin-bottom: 4px; }
  .rooms p { color: var(--muted); margin: 0; font-size: 0.92rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 16px; }
  @media (min-width: 900px) {
    .panel { grid-template-columns: 0.82fr 1.18fr; gap: 28px; padding: 22px; align-items: center; }
    .panel img { height: 420px; }
  }
</style>
