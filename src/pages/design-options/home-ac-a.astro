---
import HomeAcFrame from '../../components/design-options/HomeAcFrame.astro';
import IntroNotes from '../../components/design-options/IntroNotes.astro';
import Icon from '../../components/Icon.astro';
import { business } from '../../data/business.js';

const rooms = [
  'Bedrooms that stay hot overnight',
  'Living rooms with large windows or a south-facing aspect',
  'Home offices used through the day',
  'Garden rooms and conservatories',
];
---
<HomeAcFrame option="A" title="Option A · Home AC intro | No1">
  <section class="section opt-a" aria-label="Option A intro">
    <div class="container opt-a-grid">
      <figure>
        <img
          src="/images/installs/indoor-living-corner.webp"
          alt="White wall-mounted indoor air conditioner high on a beige living-room wall beside curtains"
          width="1050"
          height="1400"
        />
        <figcaption>Wall-mounted indoor unit</figcaption>
      </figure>
      <div>
        <h2>Sized for the room, not a brochure</h2>
        <p>Most people start with one room that will not stay comfortable. A bedroom that holds the heat, a living room with a lot of glass, a home office, or a conservatory that is too hot from May. We size the unit for that room.</p>
        <div class="chips">
          <p><strong>{business.priceFrom}</strong> <span>Clivet single room, 0% VAT</span></p>
          <p><strong>{business.multiRoomFrom}</strong> <span>Multi-room, from</span></p>
        </div>
        <h3>Where it fits</h3>
        <ul>
          {rooms.map((room) => (
            <li><Icon name="check" size={18} /><span>{room}</span></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="container">
      <IntroNotes />
    </div>
  </section>
</HomeAcFrame>

<style>
  .opt-a-grid {
    display: grid;
    gap: 28px;
    align-items: start;
  }
  .opt-a figure { margin: 0; }
  .opt-a img {
    width: 100%;
    height: 420px;
    object-fit: cover;
    object-position: center 68%;
    border-radius: 16px;
    background: var(--off-white);
  }
  .opt-a figcaption { margin-top: 8px; color: var(--muted); font-size: 0.875rem; }
  .opt-a h2 { font-size: clamp(1.6rem, 3vw, 2.15rem); margin-bottom: 12px; }
  .opt-a h3 { margin: 22px 0 12px; font-size: 1.05rem; }
  .opt-a p { color: var(--muted); margin: 0; }
  .chips { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 20px; }
  .chips p {
    margin: 0;
    background: var(--pale);
    border-radius: 12px;
    padding: 14px 16px;
    display: grid;
    gap: 2px;
  }
  .chips strong { color: var(--navy); font-size: 1.35rem; }
  .chips span { color: var(--muted); font-size: 0.875rem; font-weight: 600; }
  .opt-a ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .opt-a li { display: flex; gap: 10px; align-items: flex-start; color: var(--navy); font-weight: 650; }
  .opt-a li .icon { color: var(--blue); flex: none; margin-top: 3px; }
  @media (min-width: 900px) {
    .opt-a-grid { grid-template-columns: 0.92fr 1.08fr; gap: 48px; }
    .opt-a img { height: 520px; }
  }
</style>
