---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import MitsubishiRange from '../components/MitsubishiRange.astro';
import GuideSection from '../components/GuideSection.astro';
import QuoteSection from '../components/QuoteSection.astro';
import FaqList from '../components/FaqList.astro';
import { business, brands, faqs, openingHoursText } from '../data/business.js';
import { services } from '../data/services.js';
import { towns } from '../data/towns.js';

const title = 'Air Conditioning Installers in Ringwood | No1 Air Conditioning';
const description = `Air conditioning installation, servicing and repairs from our Ringwood showroom. Single rooms from ${business.priceFrom} inc. VAT across Hampshire and Dorset. Call ${business.phone}.`;
const steps = [
  { n: 'Step 1', title: 'Tell us about the room', text: 'A short form or a phone call. Say which rooms, and whether you want cooling, heating, or both.' },
  { n: 'Step 2', title: 'We visit and survey', text: 'We check the room, the pipe run, the power supply and where the outdoor unit can go. The survey is free.' },
  { n: 'Step 3', title: 'You get a fixed quote', text: 'The price is fixed after the survey, with no obligation to go ahead. Finance terms are only confirmed once we know the job qualifies.' },
  { n: 'Step 4', title: 'Install and handover', text: 'We fit the system and walk you through the controls, including heating mode, before we leave.' },
];
---
<Base title={title} description={description} faqs={faqs} hideGuideBanner hideReviews>
  <section class="hero hero-photo" style="background-image: url('/images/hero-mitsubishi-render.jpg');" role="region" aria-label="Introduction">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Hampshire, Dorset and New Forest specialists</p>
        <h1>Air conditioning installers in Ringwood &amp; across Hampshire and Dorset</h1>
        <p class="lead">Cool in summer, warm in winter, from a showroom you can actually visit. We design, install and look after air conditioning for homes and businesses within {business.radiusMiles} miles of our Ringwood showroom.</p>
        <div class="hero-actions">
          <a class="btn btn-lg" href="#quote">Get a free quote</a>
          <a class="btn btn-lg btn-navy" href={`tel:${business.phoneIntl}`}>Call {business.phone}</a>
        </div>
        <img class="hero-accred" src="/images/refcom-logo.png" alt="REFCOM F-Gas certificated logo" width="907" height="397" loading="eager" />
        <ul class="trust-row">
          <li><Icon name="phone" /> Call {business.phone}</li>
          <li><Icon name="pin" /> Showroom in Ringwood</li>
          <li><Icon name="check" /> Fixed-price quotes</li>
        </ul>
      </div>
      <aside class="hero-card" id="showroom-card">
        <h2>Come and see the units working live</h2>
        <p>Don't just buy from a picture.</p>
        <a class="btn btn-lg hero-card-btn" href="/about/#showroom">Book a showroom visit</a>
      </aside>
    </div>
  </section>

  <section class="brand-banner" aria-labelledby="brands-heading">
    <p class="brand-banner-label" id="brands-heading">Brands we install and supply</p>
    <ul class="brand-banner-list">
      {brands.map((brand) => (
        <li>
          {brand.logo ? (
            <img src={`/images/brands/${brand.logo}`} alt={`${brand.name} logo`} width="160" height="48" loading="lazy" />
          ) : (
            <span>{brand.name}</span>
          )}
        </li>
      ))}
    </ul>
  </section>

  <MitsubishiRange>
    <div class="visit-panel" id="showroom">
      <div>
        <p class="eyebrow">Ringwood</p>
        <h2>A local company you can actually visit</h2>
        <p>The showroom is at {business.street}, {business.town}, {business.postcode}. Hear the noise levels, compare the brands, and talk about the rooms you want done before anyone drills a wall.</p>
        <p>{business.name} is the trading name of {business.legalName}. We also trade as <a href={business.sister.url} rel="noopener noreferrer">{business.sister.name}</a>.</p>
        <div class="cluster">
          <a class="btn" href="/about/#showroom">Visit the showroom</a>
          <a class="btn btn-navy" href="#quote">Get a free quote</a>
        </div>
        <p class="google-badge" aria-label="Rated 5 out of 5 on Google"><span class="google-badge-stars" aria-hidden="true">★★★★★</span> <strong>5.0</strong> rating on Google</p>
        <iframe class="showroom-map" title="Map showing the No1 Air Conditioning showroom at 10 Christchurch Road, Ringwood, BH24 1DN" src="https://www.google.com/maps?q=10+Christchurch+Road,+Ringwood,+BH24+1DN&amp;output=embed" width="100%" height="260" style="border:0;border-radius:12px;margin-top:20px;display:block;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="showroom-card">
        <h3>Showroom</h3>
        <p>{business.street}<br />{business.town}, {business.county}<br />{business.postcode}</p>
        <p><a href={`tel:${business.phoneIntl}`}>{business.phone}</a><br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
        <img src="/images/showroom-shopfront.jpg" alt="The No1 Fires and No1 Air Conditioning showroom at 10 Christchurch Road, Ringwood" width="1200" height="800" loading="lazy" style="width:100%;height:auto;border-radius:8px;margin:8px 0;" />
        <p>Hours: {openingHoursText()}.</p>
      </div>
    </div>
  </MitsubishiRange>

  <section class="section tint" id="services">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">Our services</p>
        <h2>Air conditioning for your home or business</h2>
        <p>Installation, heating and cooling, commercial work, servicing and repairs. A single room starts from {business.priceFrom} including VAT. Multi-room systems from {business.multiRoomFrom}.</p>
      </div>
      <div class="card-grid">
        {services.map((service, index) => (
          <a class="service-card fade-in" data-delay={index * 60} href={`/services/${service.slug}/`}>
            <span class="icon-tile"><Icon name={service.icon} size={28} /></span>
            <h3>{service.name}</h3>
            <p>{service.blurb}</p>
            <span class="more">Learn more <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band band-photo">
    <picture class="band-photo-media">
      <source
        type="image/webp"
        srcset="/images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood-800.webp 800w, /images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood-1200.webp 1200w, /images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood-1600.webp 1600w, /images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood.jpg"
        srcset="/images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood-800.jpg 800w, /images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood-1200.jpg 1200w, /images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood-1600.jpg 1600w, /images/mitsubishi/mitsubishi-electric-msz-ln-pearl-white-wall-air-conditioner-lobby-ringwood.jpg 2000w"
        sizes="100vw"
        alt="Mitsubishi Electric MSZ-LN Pearl White wall-mounted air conditioner heating and cooling a bright reception area, supplied and installed by No1 Air Con in Ringwood and within 25 miles."
        width="2000"
        height="1414"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow-on-dark">All year</p>
        <h2>Not just for heatwaves</h2>
        <p>The systems we fit are air-to-air heat pumps. The unit that cools a bedroom in July heats it in January, delivering up to 4 units of warmth for every 1 unit of electricity.</p>
      </div>
      <div class="season-grid">
        <article class="season-card">
          <span class="icon-tile"><Icon name="snow" size={28} /></span>
          <h3>Summer cooling</h3>
          <p>A steady temperature, with moisture taken out of the air so the room feels less heavy. Filters catch pollen and dust.</p>
        </article>
        <article class="season-card">
          <span class="icon-tile"><Icon name="sun" size={28} /></span>
          <h3>Winter heating</h3>
          <p>Heat for the rooms that have an indoor unit. Often cheaper to run than gas for that room. It does not replace a whole-house boiler on its own.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="container">
      <div class="section-head center">
        <p class="eyebrow">How it works</p>
        <h2>From first message to cool rooms in four steps</h2>
      </div>
      <ol class="step-grid">
        {steps.map((step, i) => (
          <li class="step">
            <span class="step-no">{step.n}</span>
            <span class="step-emoji" aria-hidden="true">{['📝', '🔍', '💷', '🛠️'][i]}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <GoogleReviews />

  <section class="section tint areas-map" id="areas">
    <div class="areas-map-frame">
      <picture class="areas-map-media">
        <source
          type="image/webp"
          srcset="/images/maps/ringwood-25-mile-coverage-map-700.webp 700w, /images/maps/ringwood-25-mile-coverage-map.webp 1200w"
          sizes="100vw"
        />
        <img
          src="/images/maps/ringwood-25-mile-coverage-map.jpg"
          srcset="/images/maps/ringwood-25-mile-coverage-map-700.jpg 700w, /images/maps/ringwood-25-mile-coverage-map.jpg 1200w"
          sizes="100vw"
          alt="Map showing the 25-mile area No1 Air Con covers around its Ringwood showroom, across Hampshire and Dorset."
          width="1200"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </picture>
      <p class="areas-map-credit">
        <a href="https://www.openstreetmap.org/copyright" rel="noopener noreferrer">© OpenStreetMap contributors</a>
      </p>
    </div>
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Areas</p>
        <h2>Air conditioning across Hampshire and Dorset</h2>
        <p>Eight towns have their own pages, written for the houses and businesses there. We also travel within {business.radiusMiles} miles of our Ringwood showroom.</p>
      </div>
      <div class="area-grid">
        {towns.map((town) => (
          <a class="area-link" href={`/areas/${town.slug}/`}>
            {town.name}
            <span>{town.county}{town.miles ? ` · about ${town.miles} miles` : ' · showroom'}</span>
          </a>
        ))}
      </div>
      <p style="margin-top:20px;"><a href="/areas/">See all areas we cover</a></p>
    </div>
  </section>

  <GuideSection anchor />

  <FaqList faqs={faqs} heading="Air conditioning FAQs" />

  <section class="cta-band cta-photo">
    <picture class="cta-photo-media">
      <source
        type="image/webp"
        srcset="/images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood-800.webp 800w, /images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood-1200.webp 1200w, /images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood-1600.webp 1600w, /images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood.webp 2000w"
        sizes="100vw"
      />
      <img
        src="/images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood.jpg"
        srcset="/images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood-800.jpg 800w, /images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood-1200.jpg 1200w, /images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood-1600.jpg 1600w, /images/mitsubishi/mitsubishi-electric-msz-ln-onyx-black-home-office-ringwood.jpg 2000w"
        sizes="100vw"
        alt="Mitsubishi Electric MSZ-LN Onyx Black wall-mounted air conditioner in a bright home office, supplied and installed by No1 Air Con in Ringwood and within 25 miles."
        width="2000"
        height="1491"
        loading="lazy"
        decoding="async"
      />
    </picture>
    <div class="container">
      <div class="cta-photo-panel">
        <p class="eyebrow">Next step</p>
        <h2>Ready to get comfortable?</h2>
        <p>Tell us about the room, or come to the Ringwood showroom and hear a unit running before you decide.</p>
        <div class="cluster cta-actions">
          <a class="btn btn-lg" href="#quote">Get a free quote</a>
          <a class="btn btn-lg btn-navy" href={`tel:${business.phoneIntl}`}>Call {business.phone}</a>
        </div>
      </div>
    </div>
  </section>

  <QuoteSection />
</Base>

<style>
  .cta-photo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    align-items: center;
    min-height: 640px;
    padding: 72px 0;
  }
  .cta-photo-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    margin: 0;
    display: block;
  }
  .cta-photo-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 70% 6%;
  }
  .cta-photo::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(8, 14, 28, 0.08) 0%, rgba(8, 14, 28, 0.04) 48%, rgba(8, 14, 28, 0.16) 100%);
  }
  .cta-photo .container {
    position: relative;
    z-index: 2;
  }
  .cta-photo-panel {
    margin-inline: auto;
    max-width: 40rem;
    padding: 28px 22px 32px;
    border-radius: 18px;
    background: #0f1e3d;
    box-shadow: 0 18px 40px rgba(8, 14, 28, 0.28);
  }
  .cta-photo .eyebrow,
  .cta-photo h2,
  .cta-photo p {
    color: #fff;
  }
  .cta-photo .btn-navy {
    background: #fff;
    color: var(--navy);
    border-color: #fff;
  }
  .cta-photo .btn-navy:hover {
    background: var(--off-white);
    color: var(--navy);
    border-color: var(--off-white);
  }
  @media (min-width: 768px) {
    .cta-photo {
      min-height: 600px;
      padding: 80px 0;
    }
    .cta-photo .container {
      display: flex;
      justify-content: flex-start;
    }
    .cta-photo-panel {
      margin-inline: 0;
      padding: 36px 40px 40px;
    }
    .cta-photo-media img {
      object-position: 74% 12%;
    }
  }

  .areas-map {
    position: relative;
    overflow: hidden;
  }
  .areas-map-frame {
    position: relative;
    height: 420px;
    margin: -56px 0 8px;
  }
  .areas-map-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    margin: 0;
  }
  .areas-map-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
  }
  .areas-map-frame::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(244, 246, 249, 0) 0%, rgba(244, 246, 249, 0) 78%, rgba(244, 246, 249, 0.94) 100%);
  }
  .areas-map-credit {
    position: absolute;
    right: 10px;
    bottom: 10px;
    z-index: 2;
    margin: 0;
    padding: 2px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    font-size: 0.75rem;
    line-height: 1.4;
  }
  .areas-map-credit a {
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }
  .areas-map-credit a:hover {
    color: var(--navy);
  }

  .hero-card {
    background: #fff;
    padding: 22px 22px 20px;
    border-radius: 28px;
    border-top: 6px solid var(--orange);
    box-shadow: 0 18px 40px rgba(8, 14, 28, 0.22);
  }
  .hero-card h2 {
    font-size: clamp(1.55rem, 2.2vw, 1.9rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0;
  }
  .hero-card p {
    margin: 10px 0 0;
    color: var(--muted);
  }
  .hero-card-btn {
    width: 100%;
    margin-top: 16px;
  }
  .band-photo {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .band-photo-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    margin: 0;
  }
  .band-photo-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 22% 18%;
  }
  .band-photo::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgba(15, 30, 61, 0.12) 0%, rgba(15, 30, 61, 0.05) 46%, rgba(15, 30, 61, 0.16) 100%);
  }
  .band-photo .container {
    position: relative;
    z-index: 2;
  }
  .band-photo .section-head {
    max-width: 40rem;
    margin-bottom: 1.25rem;
    padding: 22px 22px 8px;
    border-radius: 18px;
    background: #0f1e3d;
    box-shadow: 0 16px 36px rgba(8, 14, 28, 0.22);
  }
  .band-photo .section-head p {
    color: #fff;
  }
  .band-photo .season-card {
    background: #0f1e3d;
    box-shadow: 0 16px 36px rgba(8, 14, 28, 0.22);
  }
  .band-photo .season-card p {
    color: #fff;
  }
  @media (min-width: 900px) {
    .band-photo-media img {
      object-position: 16% 8%;
    }
    .band-photo::before {
      background: linear-gradient(90deg, rgba(15, 30, 61, 0.18) 0%, rgba(15, 30, 61, 0.06) 46%, rgba(15, 30, 61, 0.02) 100%);
    }
    .band-photo .section-head {
      padding: 26px 28px 10px;
    }
  }
  @media (min-width: 768px) {
    .areas-map-frame {
      margin-top: -96px;
    }
  }
  @media (min-width: 900px) {
    .areas-map-frame {
      position: absolute;
      inset: 0;
      height: auto;
      margin: 0;
    }
    .areas-map .container {
      position: relative;
      z-index: 1;
    }
    .areas-map-frame::after {
      background: linear-gradient(180deg, rgba(244, 246, 249, 0.2) 0%, rgba(244, 246, 249, 0.05) 24%, rgba(244, 246, 249, 0) 100%);
    }
    .areas-map .section-head {
      padding: 18px 20px 6px;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 10px 28px rgba(15, 30, 61, 0.08);
    }
    .areas-map .area-link {
      background: #fff;
    }
    .areas-map-credit {
      right: 16px;
      bottom: 16px;
    }
  }
</style>
