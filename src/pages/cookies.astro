---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteSection from '../components/QuoteSection.astro';
import { business } from '../data/business.js';
const title = 'Cookie Policy | No1 Air Conditioning';
const description = `Cookies used on ${business.url}. Analytics cookies are set only if you accept them.`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Cookies', href: '/cookies/' },
];
---
<Base title={title} description={description} crumbs={crumbs} hideGuideBanner>
  <PageHero eyebrow="Legal" title="Cookie policy" lead="What this website stores on your device, written for the site as it is built today." crumbs={crumbs} />
  <section class="section">
    <div class="container prose">
      <h2>What we use</h2>
      <p>If you press Accept on the cookie banner, we load Google Analytics. It sets a cookie so repeat visits can be counted, and so we can see which pages are used. We do not send your name, email address or phone number with it.</p>
      <p>If you press Reject, Google Analytics is not loaded and those cookies are not set.</p>
      <p>A Meta pixel and a Google Ads tag are not loaded while their IDs are empty. If either is switched on later, it loads only after you accept cookies, using the same choice as analytics.</p>
      <p>The quote form does not need a cookie of its own. The site is hosted on Cloudflare. Cloudflare may set a strictly necessary cookie to keep the site secure and reliable. We do not use that for advertising.</p>
      <h2>How to change your choice</h2>
      <p>Use Cookie settings in the footer of any page. You can also block or delete cookies in your browser settings. Blocking a strictly necessary host cookie should not stop you reading the pages or calling {business.phone}.</p>
      <p>Questions: <a href={`mailto:${business.email}`}>{business.email}</a>.</p>
    </div>
  </section>
  <QuoteSection />
</Base>
