---
import CountyPage from '../../components/CountyPage.astro';
import { business, whatsappSend } from '../../data/business.js';
import { pagePhotos } from '../../data/lifestyle.js';

const county = {
  slug: 'hampshire',
  name: 'Hampshire',
  title: 'Air Conditioning in Hampshire | No1 Air Con',
  description: `Air conditioning installation, servicing and repairs across Hampshire, within ${business.radiusMiles} miles of our Ringwood showroom. Ask for a remote quote.`,
  photo: pagePhotos.hampshire,
  eyebrow: 'Hampshire',
  h1: 'Air conditioning installers across Hampshire',
  lead: `We are based in Ringwood, on the edge of the New Forest, and install across Hampshire within ${business.radiusMiles} miles of our Ringwood showroom at ${business.street}, ${business.postcode}.`,
  paragraphs: [
    `Our Hampshire work is quoted from the Ringwood showroom. Ringwood, Fordingbridge, New Milton, Southampton and Portsmouth each have their own page. Southampton is inside the radius we already name. Portsmouth is further east, so we check the address. Warsash, just outside Southampton, is written up in the [Warsash case study](/case-studies/warsash-chalet-bungalow/). Published prices are on the [air conditioning cost](/air-conditioning-cost/) page. ${whatsappSend}. A survey is only if it is needed.`,
    'Hampshire homes vary a lot. Forest-edge cottages often have thick walls and small rooms, while newer estates usually give a clearer route for pipes and an outdoor unit. Shops, offices and treatment rooms are sized for how the space is used, not by a rule of thumb.',
    `You can compare Mitsubishi Electric, Daikin, Clivet, Toshiba, Panasonic and Samsung at the showroom before you decide, and hear them running. Call ${business.phone} to ask whether we survey a particular address.`,
    'One job in the county is a chalet bungalow conversion in Warsash, just outside Southampton. It is not a Southampton city address. After the house was insulated it got very hot upstairs, including a child’s bedroom. The write-up is the [Warsash case study](/case-studies/warsash-chalet-bungalow/).',
  ],
  answerFaqs: [
    {
      q: 'Do you install air conditioning across Hampshire?',
      a: `Yes, within ${business.radiusMiles} miles of our Ringwood showroom. Hampshire pages include Ringwood, Fordingbridge, New Milton, Southampton and Portsmouth. Southampton is already named inside that radius. Portsmouth is further east, so call ${business.phone} with the address.`,
    },
    {
      q: 'How much does air conditioning cost in Hampshire?',
      a: `A Clivet single room system is installed from ${business.priceFrom} (0% VAT). That is the cheapest Clivet option, not a price for every brand. The cost guide sets the other published prices out in one place. Send photos, measurements and a floor plan and we quote remotely. ${whatsappSend}. A survey is only if it is needed.`,
    },
    {
      q: 'Can I see the units before I buy?',
      a: `Yes. Visit the showroom at ${business.street}, ${business.town}, to compare the brands side by side.`,
    },
  ],
  faqs: [
    {
      q: 'What warranty do Hampshire installations come with?',
      a: 'Installations come with a 5 year warranty that covers parts and labour.',
    },
    {
      q: 'Do you work on commercial premises in Hampshire?',
      a: `Yes. Offices, shops, treatment rooms and server rooms are sized for how the space is used. Commercial prices are a remote quote from photos, measurements and a floor plan. ${whatsappSend}. A survey is only if it is needed.`,
    },
  ],
};
---
<CountyPage county={county} />
