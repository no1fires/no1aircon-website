---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuickAnswers from '../../components/QuickAnswers.astro';
import FaqList from '../../components/FaqList.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import GuideSection from '../../components/GuideSection.astro';
import Related from '../../components/Related.astro';
import { towns, getTown, getTownsBySlugs } from '../../data/towns.js';
import { getServicesBySlugs } from '../../data/services.js';
import { business, whatsappSend } from '../../data/business.js';
import { townPhotos } from '../../data/lifestyle.js';
import RichText from '../../components/RichText.astro';

export function getStaticPaths() {
  return towns.map((town) => ({ params: { slug: town.slug } }));
}

const town = getTown(Astro.params.slug);
const services = getServicesBySlugs(town.services);
const nearby = getTownsBySlugs(town.nearby);
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Areas', href: '/areas/' },
  { name: town.name, href: `/areas/${town.slug}/` },
];
const distance = town.miles === 0
  ? `The showroom is in ${town.name}, at ${business.street}.`
  : Number.isFinite(town.miles)
    ? `${town.name} is about ${town.miles} miles from the showroom at ${business.street}, ${business.town}.`
    : typeof town.miles === 'string'
      ? `${town.name} is ${town.miles} of the showroom at ${business.street}, ${business.town}.`
      : `The showroom is in Ringwood, at ${business.street}, ${business.town}.`;
---
<Base
  title={town.title}
  description={town.description}
  crumbs={crumbs}
  faqs={[...town.answerFaqs, ...town.faqs]}
  locality={town.background ? { name: town.name, county: town.county, description: town.description } : null}
>
  <PageHero eyebrow={town.eyebrow} title={town.h1} lead={town.lead} crumbs={crumbs} photo={townPhotos[town.slug]} />
  <QuickAnswers faqs={town.answerFaqs} />
  <section class="section">
    <div class="container prose">
      <p><strong>{distance}</strong> {town.county}.</p>
      {town.paragraphs.map((paragraph) => <p><RichText text={paragraph} /></p>)}
    </div>
  </section>
  {town.feature && (
    <section class="section" style="padding-top:0;" aria-labelledby="town-case-heading">
      <div class="container">
        <a class="case-feature" href={town.feature.href}>
          <img src={town.feature.src} alt={town.feature.alt} width={town.feature.width} height={town.feature.height} />
          <div>
            <p class="eyebrow">Case study</p>
            <h2 id="town-case-heading">{town.feature.title}</h2>
            <p>{town.feature.text}</p>
            <span class="btn">Read the case study</span>
          </div>
        </a>
      </div>
    </section>
  )}
  <section class="section tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Useful here</p>
        <h2>Services that suit {town.name}</h2>
        <p>{town.servicesIntro}</p>
      </div>
      <div class="related-grid">
        {services.map((service) => (
          <a class="area-link" href={`/services/${service.slug}/`}>
            {service.name} in {town.name}
            <span>{service.blurb}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <GuideSection />
  <Related towns={nearby} heading={`Towns near ${town.name}`} />
  <FaqList faqs={town.faqs} heading={`Questions about ${town.name}`} />
  <QuoteSection title={`Quote for a property in ${town.name}`} intro={`Tell us the ${town.name} address, or just the postcode, and which rooms you want looked at. Send photos, measurements and a floor plan and we quote remotely, within ${business.radiusMiles} miles of our Ringwood showroom. ${whatsappSend}. Published prices are on the [air conditioning cost](/air-conditioning-cost/) page.`} />
</Base>

<style>
  .case-feature {
    display: grid;
    background: var(--blue);
    border-radius: 16px;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
  }
  .case-feature:hover { color: #fff; }
  .case-feature img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    object-position: center 36%;
  }
  .case-feature div { padding: 22px 24px 26px; }
  .case-feature h2 { color: #fff; font-size: 1.5rem; margin: 0 0 8px; }
  .case-feature p { color: #fff; margin: 0 0 16px; }
  .case-feature .eyebrow { color: #fff; }
  .case-feature .btn { align-self: flex-start; }
  @media (min-width: 800px) {
    .case-feature { grid-template-columns: 320px minmax(0, 1fr); align-items: stretch; }
    .case-feature img { width: 320px; height: 100%; min-height: 240px; }
    .case-feature div { display: flex; flex-direction: column; justify-content: center; }
  }
</style>
