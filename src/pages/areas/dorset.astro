---
import CountyPage from '../../components/CountyPage.astro';
import { business, whatsappSend } from '../../data/business.js';
import { pagePhotos } from '../../data/lifestyle.js';

const county = {
  slug: 'dorset',
  name: 'Dorset',
  title: 'Air Conditioning in Dorset | No1 Air Con',
  description: `Air conditioning installation, servicing and repairs across East Dorset, within ${business.radiusMiles} miles of our Ringwood showroom. Ask for a remote quote.`,
  photo: pagePhotos.dorset,
  eyebrow: 'Dorset',
  h1: 'Air conditioning installers across Dorset',
  lead: `We install across East Dorset within ${business.radiusMiles} miles of our Ringwood showroom, including Ferndown, Verwood, St Leonards, Christchurch and Wimborne.`,
  paragraphs: [
    `Our Dorset work is quoted from Ringwood, just across the county line in Hampshire. Each Dorset town below has its own page with local detail. The wider area inside our radius gets the same remote quote from photos, measurements and a floor plan. ${whatsappSend}. A survey is only if it is needed.`,
    `East Dorset homes range from older town-centre houses to newer estates and bungalows. The position of the outdoor unit and the pipe run usually decide what is possible, so send photos of both with the measurements and floor plan. ${whatsappSend}. We visit only if we need to.`,
    `Christchurch Road is the showroom address in Ringwood, not the town of Christchurch. If you are visiting, use ${business.street}, ${business.town}, ${business.postcode}.`,
  ],
  answerFaqs: [
    {
      q: 'Do you install air conditioning in Dorset?',
      a: `Yes, across East Dorset within ${business.radiusMiles} miles of our Ringwood showroom. Our Dorset towns are Ferndown, Verwood, St Leonards, Christchurch and Wimborne.`,
    },
    {
      q: 'How much does air conditioning cost in Dorset?',
      a: `A Clivet single room system is installed from ${business.priceFrom} (0% VAT). Send photos, measurements and a floor plan and we quote remotely. ${whatsappSend}. A survey is only if it is needed.`,
    },
    {
      q: 'Can I see the units before I buy?',
      a: `Yes. Visit the showroom at ${business.street}, ${business.town}, to compare the brands side by side.`,
    },
  ],
  faqs: [
    {
      q: 'What warranty do Dorset installations come with?',
      a: 'Installations come with a 5 year warranty that covers parts and labour.',
    },
    {
      q: 'Can you heat a home in Dorset as well as cool it?',
      a: 'Yes. The systems we fit are air-to-air heat pumps, so they heat as well as cool. They are often cheaper to run than gas for the rooms they serve, but they do not replace a whole-house boiler on their own.',
    },
  ],
};
---
<CountyPage county={county} />
