---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuickAnswers from '../../components/QuickAnswers.astro';
import FaqList from '../../components/FaqList.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import InstallCarousel from '../../components/InstallCarousel.astro';
import Related from '../../components/Related.astro';
import Icon from '../../components/Icon.astro';
import { services, getService, getServicesBySlugs } from '../../data/services.js';
import { getTownsBySlugs } from '../../data/towns.js';
import { servicePhotos } from '../../data/lifestyle.js';
import RichText from '../../components/RichText.astro';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const service = getService(Astro.params.slug);
const related = getServicesBySlugs(service.related);
const towns = getTownsBySlugs(service.towns);
const installShots = {
  'home-air-conditioning': {
    src: '/images/installs/indoor-living-corner.webp',
    width: 1050,
    height: 1400,
    caption: 'Wall-mounted indoor unit',
    alt: 'White wall-mounted indoor air conditioner high on a beige living-room wall beside curtains',
  },
  'heating-and-cooling': {
    src: '/images/installs/indoor-wall-light.webp',
    width: 1050,
    height: 1400,
    caption: 'Wall-mounted indoor unit',
    alt: 'White wall-mounted indoor air conditioner on a pale wall beside a lit wall light',
  },
  'commercial-air-conditioning': {
    src: '/images/installs/indoor-slatted-wall.webp',
    width: 739,
    height: 556,
    caption: 'Wall-mounted indoor unit',
    alt: 'White wall-mounted indoor air conditioner on a grey slatted wall',
  },
  servicing: {
    src: '/images/installs/outdoor-brick-wall.webp',
    width: 1200,
    height: 900,
    caption: 'Outdoor unit installation',
    alt: 'Cream outdoor air conditioner mounted on brackets on a red-brick house wall above patio doors',
  },
  repairs: {
    src: '/images/installs/outdoor-cottage.webp',
    width: 900,
    height: 1200,
    caption: 'Outdoor unit installation',
    alt: 'White outdoor air conditioner on feet beside a white rendered cottage wall',
  },
  'ducted-and-ceiling-systems': {
    src: '/images/installs/outdoor-bungalow.webp',
    width: 900,
    height: 1200,
    caption: 'Outdoor unit installation',
    alt: 'Cream outdoor air conditioner on feet on a gravel border beside a brick bungalow',
  },
};
const installShot = installShots[service.slug];
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.name, href: `/services/${service.slug}/` },
];
const faqs = [...service.answerFaqs, ...service.faqs];
---
<Base title={service.title} description={service.description} crumbs={crumbs} faqs={faqs} service={service}>
  <PageHero eyebrow={service.eyebrow} title={service.h1} lead={service.lead} crumbs={crumbs} photo={servicePhotos[service.slug]} />
  <section class="section service-intro">
    <div class="container split">
      <div class="prose">
        {service.paragraphs.map((paragraph) => <p><RichText text={paragraph} /></p>)}
        <p><strong><RichText text={service.priceNote} /></strong></p>
      </div>
      <div class="fit-col">
        <h2>Where it fits</h2>
        <ul class="check-list">
          {service.suitable.map((item) => (
            <li><Icon name="check" size={18} /><span>{item}</span></li>
          ))}
        </ul>
        <figure class="fit-photo">
          <img
            src={installShot.src}
            alt={installShot.alt}
            width={installShot.width}
            height={installShot.height}
            loading="lazy"
            decoding="async"
          />
          <figcaption>{installShot.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>
  <QuickAnswers faqs={service.answerFaqs} />
  <section class="section tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2>What this includes</h2>
      </div>
      <div class="card-grid">
        {service.provides.map((item) => (
          <article class="provide">
            <span class="icon-tile"><Icon name={service.icon} size={26} /></span>
            <h3>{item.title}</h3>
            <p><RichText text={item.text} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <Related services={related} towns={towns} />
  <FaqList faqs={service.faqs} />
  <InstallCarousel instanceId={service.slug} />
  <QuoteSection title={`Quote for ${service.name.toLowerCase()}`} />
</Base>
