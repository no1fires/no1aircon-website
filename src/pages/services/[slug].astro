---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import QuickAnswers from '../../components/QuickAnswers.astro';
import FaqList from '../../components/FaqList.astro';
import QuoteSection from '../../components/QuoteSection.astro';
import InstallCarousel from '../../components/InstallCarousel.astro';
import GuideSection from '../../components/GuideSection.astro';
import Related from '../../components/Related.astro';
import Icon from '../../components/Icon.astro';
import { services, getService, getServicesBySlugs } from '../../data/services.js';
import { getTownsBySlugs } from '../../data/towns.js';
import { servicePhotos } from '../../data/lifestyle.js';
import RichText from '../../components/RichText.astro';
import { business, brands, whatsappSend } from '../../data/business.js';
import { brandList } from '../../lib/format.js';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug } }));
}

const service = getService(Astro.params.slug);
const related = getServicesBySlugs(service.related);
const towns = getTownsBySlugs(service.towns);
const installShots = {
  'home-air-conditioning': {
    src: '/images/installs/indoor-living-corner.webp',
    width: 1050,
    height: 1400,
    caption: 'Wall-mounted indoor unit',
    alt: 'White wall-mounted indoor air conditioner high on a beige living-room wall beside curtains',
    position: 'center 46%',
  },
  'heating-and-cooling': {
    src: '/images/installs/indoor-wall-light.webp',
    width: 1050,
    height: 1400,
    caption: 'Wall-mounted indoor unit',
    alt: 'White wall-mounted indoor air conditioner on a pale wall beside a lit wall light',
    position: 'center 55%',
  },
  'commercial-air-conditioning': {
    src: '/images/installs/indoor-slatted-wall.webp',
    width: 739,
    height: 556,
    caption: 'Wall-mounted indoor unit',
    alt: 'White wall-mounted indoor air conditioner on a grey slatted wall',
    position: 'center',
  },
  servicing: {
    src: '/images/installs/outdoor-brick-wall.webp',
    width: 1200,
    height: 900,
    caption: 'Outdoor unit installation',
    alt: 'Cream outdoor air conditioner mounted on brackets on a red-brick house wall above patio doors',
    position: 'center',
  },
  repairs: {
    src: '/images/installs/outdoor-cottage.webp',
    width: 900,
    height: 1200,
    caption: 'Outdoor unit installation',
    alt: 'White outdoor air conditioner on feet beside a white rendered cottage wall',
    position: 'center 40%',
  },
  'ducted-and-ceiling-systems': {
    src: '/images/installs/outdoor-bungalow.webp',
    width: 900,
    height: 1200,
    caption: 'Outdoor unit installation',
    alt: 'Cream outdoor air conditioner on feet on a gravel border beside a brick bungalow',
    position: '78% 72%',
  },
};
const installShot = installShots[service.slug];
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.name, href: `/services/${service.slug}/` },
];
const faqs = [...service.answerFaqs, ...service.faqs];
const quoteSteps = [
  { n: '1', title: 'Send the photos', text: 'Photos, measurements and a floor plan of the rooms and the outside wall.' },
  { n: '2', title: 'We quote remotely', text: 'The price comes from those. There is no need for a visit to get a price.' },
  { n: '3', title: 'Survey only if needed', text: 'A lot of the time it is not. We say so before anyone comes out.' },
  { n: '4', title: 'Most jobs, one day', text: 'Lead time is 4 to 8 weeks. Stock is often sooner. That is not a promise.' },
];
const intros = {
  'home-air-conditioning': {
    heading: 'Start with the room that will not stay comfortable',
    lead: 'A bedroom, a living room with a lot of glass, a home office, or a conservatory. The unit is sized for that room.',
    cards: [
      { kicker: 'Single room', title: `From ${business.priceFrom}`, text: 'Clivet, 0% VAT. One indoor unit and one outdoor unit.' },
      { kicker: 'Multi-room', title: `From ${business.multiRoomFrom}`, text: 'Two, three or four indoor units on one outdoor unit. Each room has its own setting.' },
      { kicker: 'Where it fits', title: 'The rooms you use', text: 'Hot bedrooms, glazed living rooms, home offices, garden rooms and conservatories.' },
    ],
    steps: quoteSteps,
    notesTitle: 'Placement, brands and how the quote works',
    notes: [
      'The indoor unit can sit high on a wall, or on the floor if a wall is taken up by windows. The outdoor unit needs a sensible spot: somewhere it can be fixed securely, where the pipes can run neatly, and where the noise will not sit under a neighbour’s bedroom window.',
      'If you want more than one room, a multi-room system connects two, three or four indoor units to a single outdoor unit. You can set each room on its own. It avoids a row of outdoor units along the wall.',
      `We install ${brandList(brands)}. You can see and hear them at the showroom on ${business.street}, ${business.town}, before you decide. Mitsubishi Electric publish a low noise figure from 19dB for some of their indoor units. That is their figure for those models, not a promise that every room will measure 19dB once the unit is fitted.`,
      `Send photos, measurements and a floor plan of the rooms and the outside wall. ${whatsappSend}. We quote remotely from those. A survey is only if it is needed.`,
    ],
  },
  'heating-and-cooling': {
    heading: 'The same unit cools in summer and heats in winter',
    lead: 'It heats the rooms where an indoor unit is fitted. It does not heat the hot water, and it does not replace a boiler on its own.',
    cards: [
      { kicker: 'Single room', title: `From ${business.priceFrom}`, text: 'Clivet, 0% VAT. The same unit heats and cools.' },
      { kicker: 'How it heats', title: 'It moves heat', text: 'Up to 4 units of warmth for every 1 unit of electricity. The real cost depends on your tariff, the insulation and how long you leave it on.' },
      { kicker: 'Where it fits', title: 'Rooms you sit in', text: 'Rooms you heat for hours, home offices, conservatories and bedrooms.' },
    ],
    steps: quoteSteps,
    notesTitle: 'Running costs, cold weather and the rest of the house',
    notes: service.paragraphs,
  },
  'commercial-air-conditioning': {
    heading: 'Sized for how the room is used',
    lead: 'A treatment room, a shop with the door open all day, and a server cupboard are different jobs. We ask how the room is used before we suggest a system.',
    cards: [
      { kicker: 'Offices', title: 'People and equipment', text: 'Sized for how many people use the room and the heat from equipment, not just the floor area.' },
      { kicker: 'Shops and treatment rooms', title: 'Doors and quiet', text: 'Shops need to cope with the door opening. Treatment rooms need to stay quiet.' },
      { kicker: 'Server cupboards', title: 'When the building is shut', text: 'Cooling that can run when nobody is in the building.' },
    ],
    steps: [
      { n: '1', title: 'Send the photos', text: 'Photos, measurements and a floor plan, including the ceiling if there is a void.' },
      { n: '2', title: 'Tell us the use', text: 'How many people, any equipment that throws off heat, and the hours you are open.' },
      { n: '3', title: 'We quote remotely', text: 'A survey is only if it is needed.' },
      { n: '4', title: 'Agree the working day', text: 'We book the install so it does not close the business for longer than it needs to.' },
    ],
    notesTitle: 'Cassettes, wall units and the quote',
    notes: service.paragraphs,
  },
  servicing: {
    heading: 'A yearly service keeps the warranty valid',
    lead: 'We look at filters, coils, the condensate drain, temperatures, electrical connections and signs of a refrigerant leak.',
    cards: [
      { kicker: 'Servicing', title: `From ${business.servicingFrom}`, text: 'Recommended yearly. A check, not a five-minute filter rinse.' },
      { kicker: 'Warranty', title: '5 year parts and labour', text: 'Skipping the service is the usual reason a warranty claim is turned down.' },
      { kicker: 'Engineers', title: 'F-Gas through REFCOM', text: 'We service the brands we install, for homes and small businesses.' },
    ],
    steps: [
      { n: '1', title: 'Book the next visit', text: 'Ask us to book it before we leave, or call and send the details.' },
      { n: '2', title: 'We check the system', text: 'Filters, coils, drain, temperatures, electrics and a leak check.' },
      { n: '3', title: 'The warranty stays valid', text: 'Installations come with a 5 year warranty that covers parts and labour.' },
      { n: '4', title: 'A fault is a repair', text: 'Leaking, an error code or not cooling is a repair, not a service. Tell us when you book.' },
    ],
    notesTitle: 'What a service covers',
    notes: service.paragraphs,
  },
  repairs: {
    heading: 'Not cooling, leaking, or showing a code',
    lead: 'Tell us the brand, roughly how old the system is, and what it is doing. A photo of the error code saves a wasted visit.',
    cards: [
      { kicker: 'Fault finding', title: 'What it is doing', text: 'Poor cooling, poor heating, new noises, or a system that will not start.' },
      { kicker: 'Water indoors', title: 'Switch it off', text: 'Switch it off at the isolator if water is coming into the room, and call us. Do not take the unit apart.' },
      { kicker: 'When to call', title: business.phone, text: 'During showroom hours. We do not offer an overnight call-out.' },
    ],
    steps: [
      { n: '1', title: 'Brand and symptoms', text: 'The brand, roughly how old it is, and what it is doing now.' },
      { n: '2', title: 'A photo of the code', text: 'A photo of the error code on the controller saves a wasted visit.' },
      { n: '3', title: 'The price before the work', text: 'We tell you the fault and the price to put it right before the paid work starts.' },
      { n: '4', title: 'Showroom hours', text: `Call ${business.phone}. If the phone is not answered, email ${business.email}.` },
    ],
    notesTitle: 'Leaks, parts and the warranty',
    notes: service.paragraphs,
  },
  'ducted-and-ceiling-systems': {
    heading: 'When a wall unit is the wrong answer',
    lead: 'A cassette or a ducted system needs room in the ceiling or the loft, and a way to reach the filters later. If that room is not there, we say so.',
    cards: [
      { kicker: 'Cassette', title: 'In the ceiling', text: 'One unit you can see, usually blowing in more than one direction. Common in offices and open rooms.' },
      { kicker: 'Ducted', title: 'Hidden, with grilles', text: 'Only where the void is deep enough and the filters can still be reached next year.' },
      { kicker: 'If it will not fit', title: 'We will say so', text: 'A wall or floor unit is often the better install. We will not force a ceiling system into a void that is too small.' },
    ],
    steps: [
      { n: '1', title: 'Photos of the ceiling', text: 'The ceiling, the joists if you can see them, measurements and a floor plan.' },
      { n: '2', title: 'We quote remotely', text: 'Two ceilings that look the same can be different jobs.' },
      { n: '3', title: 'A visit only if needed', text: 'We visit only if the photos are not enough.' },
      { n: '4', title: 'Nothing is cut first', text: 'We agree the positions before we cut anything.' },
    ],
    notesTitle: 'Space, access and the quote',
    notes: service.paragraphs,
  },
};
const intro = intros[service.slug];
---
<Base title={service.title} description={service.description} crumbs={crumbs} faqs={faqs} service={service}>
  <PageHero eyebrow={service.eyebrow} title={service.h1} lead={service.lead} crumbs={crumbs} photo={servicePhotos[service.slug]} />
  <section class="section home-intro" aria-labelledby="service-intro-heading">
    <div class="container">
      <figure>
        <img
          src={installShot.src}
          alt={installShot.alt}
          width={installShot.width}
          height={installShot.height}
          style={`object-position: ${installShot.position}`}
        />
      </figure>
      <div class="intro-copy">
        <h2 id="service-intro-heading">{intro.heading}</h2>
        <p>{intro.lead}</p>
      </div>
      <div class="cards">
        {intro.cards.map((card) => (
          <article>
            <p class="kicker">{card.kicker}</p>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
      <ol class="steps">
        {intro.steps.map((step) => (
          <li>
            <span>{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))}
      </ol>
      <details class="intro-notes" open>
        <summary>{intro.notesTitle}</summary>
        <div>
          {intro.notes.map((note) => <p><RichText text={note} /></p>)}
        </div>
      </details>
    </div>
  </section>
  {service.slug === 'home-air-conditioning' && (
    <section class="section" aria-labelledby="warsash-case-heading">
      <div class="container">
        <div class="case-strip">
          <img
            src="/images/case-studies/warsash-chalet-bungalow-childs-bedroom-daikin-800.webp"
            alt="Daikin wall-mounted air conditioning unit fitted high on the sloped wall of a child's bedroom in a Warsash, Southampton chalet bungalow"
            width="800"
            height="1067"
            loading="lazy"
            decoding="async"
          />
          <div>
            <h2 id="warsash-case-heading">Case study: cooling a chalet bungalow in Warsash, Southampton</h2>
            <p>The house got very hot in summer after it was insulated. Two Daikin single splits were fitted in one day.</p>
            <a class="btn" href="/case-studies/warsash-chalet-bungalow/">Read the case study</a>
          </div>
        </div>
      </div>
    </section>
  )}
  <QuickAnswers faqs={service.answerFaqs} />
  <section class="section tint">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2>What this includes</h2>
      </div>
      <div class="card-grid">
        {service.provides.map((item) => (
          <article class="provide">
            <span class="icon-tile"><Icon name={service.icon} size={26} /></span>
            <h3>{item.title}</h3>
            <p><RichText text={item.text} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <GuideSection />
  <Related services={related} towns={towns} />
  <FaqList faqs={service.faqs} />
  <InstallCarousel instanceId={service.slug} />
  <QuoteSection title={`Quote for ${service.name.toLowerCase()}`} />
</Base>

<style>
  .case-strip {
    display: grid;
    background: var(--blue);
    border-radius: 16px;
    overflow: hidden;
    color: #fff;
  }
  .case-strip img {
    width: 100%;
    height: 220px;
    object-fit: cover;
    object-position: center 30%;
  }
  .case-strip div { padding: 22px 24px; }
  .case-strip h2 { color: #fff; font-size: 1.35rem; margin-bottom: 8px; }
  .case-strip p { color: #fff; margin: 0 0 16px; }
  .case-strip .btn { align-self: flex-start; }
  @media (min-width: 800px) {
    .case-strip { grid-template-columns: 280px minmax(0, 1fr); align-items: stretch; }
    .case-strip img { width: 280px; height: 240px; }
    .case-strip div { display: flex; flex-direction: column; justify-content: center; }
  }
  .home-intro figure { margin: 0; }
  .home-intro img {
    width: 100%;
    height: 240px;
    object-fit: cover;
    object-position: center;
    border-radius: 20px;
  }
  .intro-copy { max-width: 68ch; margin: 28px 0 22px; }
  .intro-copy h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); margin-bottom: 10px; }
  .intro-copy p { color: var(--muted); margin: 0; font-size: 1.05rem; }
  .cards { display: grid; gap: 14px; }
  .cards article {
    background: #fff;
    border-radius: 16px;
    padding: 18px 18px 16px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .kicker { margin: 0 0 6px; color: var(--blue); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .cards h3 { margin-bottom: 6px; }
  .cards p { margin: 0; color: var(--muted); }
  .steps { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 12px; }
  .steps li { background: var(--pale); border-radius: 16px; padding: 16px; }
  .steps span {
    display: inline-grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--navy);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
    margin-bottom: 8px;
  }
  .steps h3 { font-size: 1rem; margin-bottom: 4px; }
  .steps p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .intro-notes {
    margin-top: 28px;
    background: #fff;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .intro-notes summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--navy);
    padding: 16px 20px;
    list-style: none;
  }
  .intro-notes summary::-webkit-details-marker { display: none; }
  .intro-notes summary::after { content: '+'; float: right; color: var(--blue); }
  .intro-notes[open] summary::after { content: '–'; }
  .intro-notes div { padding: 0 20px 18px; }
  .intro-notes p { color: var(--muted); margin: 0 0 12px; }
  @media (min-width: 900px) {
    .home-intro img { height: 360px; }
    .cards { grid-template-columns: repeat(3, 1fr); }
    .steps { grid-template-columns: repeat(4, 1fr); }
  }
</style>
