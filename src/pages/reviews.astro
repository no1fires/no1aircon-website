---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteSection from '../components/QuoteSection.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import { business } from '../data/business.js';
import { pagePhotos } from '../data/lifestyle.js';

const title = 'Reviews | No1 Air Con Ringwood';
const description = `Google reviews for No1 Air Conditioning in Ringwood. ${business.rating.value} from ${business.rating.count} reviews.`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Reviews', href: '/reviews/' },
];
---
<Base title={title} description={description} crumbs={crumbs} hideReviews>
  <PageHero
    eyebrow="Reviews"
    title="What customers say"
    lead={`${business.rating.value} from ${business.rating.count} Google reviews.`}
    crumbs={crumbs}
    photo={pagePhotos.reviews}
  />
  <GoogleReviews showGrid />
  <section class="section">
    <div class="container">
      <p>To talk to us directly, call <a href={`tel:${business.phoneIntl}`}>{business.phone}</a>.</p>
    </div>
  </section>
  <QuoteSection />
</Base>
