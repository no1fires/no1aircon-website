---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import QuoteSection from '../components/QuoteSection.astro';
import ShowroomMap from '../components/ShowroomMap.astro';
import { business, openingHoursText, whatsappSend } from '../data/business.js';
import RichText from '../components/RichText.astro';
import { pagePhotos } from '../data/lifestyle.js';

const title = 'Contact No1 Air Con | Ringwood Showroom';
const description = `Contact No1 Air Conditioning at ${business.street}, ${business.town} ${business.postcode}. Call ${business.phone} or email ${business.email} for a remote quote.`;
const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
const whatsappText = "Hi No1 Air Con, I'd like to ask about air conditioning.";
const whatsappHref = business.whatsappIntl
  ? `https://wa.me/${String(business.whatsappIntl).replace('+', '')}?text=${encodeURIComponent(whatsappText)}`
  : '';
---
<Base title={title} description={description} crumbs={crumbs}>
  <PageHero
    eyebrow="Contact"
    title="Talk to us about the room"
    lead={`Call, email, or send photos, measurements and a floor plan. ${whatsappSend}. We quote remotely. A survey is only if it is needed. The form is only delivered once the enquiry address is connected.`}
    crumbs={crumbs}
    photo={pagePhotos.contact}
  />
  <section class="section">
    <div class="container split">
      <div class="prose">
        <h2>Showroom and phone</h2>
        <p><strong>{business.name}</strong><br />{business.legalName}</p>
        <p>{business.street}<br />{business.town}<br />{business.county}<br />{business.postcode}</p>
        <p><a href={`tel:${business.phoneIntl}`}>{business.phone}</a><br />{whatsappHref && <><a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp us</a><br /></>}<a href={`mailto:${business.email}`}>{business.email}</a></p>
        <p>Opening hours: {openingHoursText()}.</p>
        <p><RichText text={`Send photos, measurements and a floor plan of the rooms and the outside wall, including where the outdoor unit could go. ${whatsappSend}. That is enough for a remote quote. A survey is only if it is needed, and a lot of the time it is not.`} /></p>
      </div>
      <ShowroomMap />
    </div>
  </section>
  <QuoteSection title="Send an enquiry" />
</Base>
