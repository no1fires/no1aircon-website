---
import '../styles/global.css';
import { business, services, areas } from '../data/business.js';

const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': `${business.url}/#business`,
  name: business.name,
  alternateName: business.shortName,
  legalName: business.legalName,
  url: business.url + '/',
  logo: `${business.url}/images/no1-aircon-logo.svg`,
  image: `${business.url}/images/no1-aircon-logo.svg`,
  telephone: business.phoneIntl,
  email: business.email,
  priceRange: `From ${business.priceFrom}`,
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.street,
    addressLocality: business.town,
    addressRegion: business.county,
    postalCode: business.postcode,
    addressCountry: 'GB',
  },
  geo: { '@type': 'GeoCoordinates', latitude: business.geo.lat, longitude: business.geo.lng },
  areaServed: areas.map((a) => ({ '@type': 'Place', name: a })),
  sameAs: [business.facebook, business.instagram],
  makesOffer: services.map((s) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: s.name } })),
};
const allSchema = [localBusiness, ...schema];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:locale" content="en_GB" />
  <meta name="theme-color" content="#0f1e3d" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bitter:wght@700;800&family=Figtree:wght@400;600;700&display=swap" rel="stylesheet" />
  {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <div class="stripe" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
  <div class="topbar">
    <div class="wrap topbar-in">
      <span>Showroom: {business.street}, {business.town} {business.postcode}</span>
      <span>0% finance available · Up to 5 year warranty</span>
    </div>
  </div>
  <header class="header">
    <div class="wrap header-in">
      <a href="/" class="logo" aria-label={`${business.name} home`}>
        <img src="/images/no1-aircon-logo.svg" alt={business.name} width="224" height="56" />
      </a>
      <nav aria-label="Main" class="nav">
        <a href="/#services">Services</a>
        <a href="/#areas">Areas</a>
        <a href="/#showroom">Showroom</a>
        <a href="/#faqs">FAQs</a>
        <a href="/#quote">Contact</a>
      </nav>
      <div class="header-cta">
        <a class="phone" href={`tel:${business.phoneIntl}`}>{business.phone}</a>
        <a class="btn" href="/#quote">Get a free quote</a>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="footer">
    <div class="stripe" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    <div class="wrap footer-grid">
      <div>
        <img src="/images/no1-aircon-logo-white.svg" alt={business.name} width="208" height="52" />
        <p>Air conditioning installation, servicing and repairs across Hampshire, Dorset and the New Forest, from our showroom in Ringwood.</p>
      </div>
      <div>
        <h2>Services</h2>
        <ul>{services.map((s) => <li><a href="/#services">{s.name}</a></li>)}</ul>
      </div>
      <div>
        <h2>Areas</h2>
        <ul>{areas.slice(0, 8).map((a) => <li><a href="/#areas">{a}</a></li>)}</ul>
      </div>
      <div>
        <h2>Contact</h2>
        <address>
          {business.street}<br />{business.town}, {business.county}<br />{business.postcode}<br />
          <a class="footer-phone" href={`tel:${business.phoneIntl}`}>{business.phone}</a><br />
          <a href={`mailto:${business.email}`}>{business.email}</a>
        </address>
        <p class="social"><a href={business.facebook}>Facebook</a> · <a href={business.instagram}>Instagram</a></p>
      </div>
    </div>
    <div class="wrap footer-base">
      <span>© {year} {business.legalName}, trading as {business.name}.</span>
      <span><a href="/privacy/">Privacy</a> · <a href="/terms/">Terms</a></span>
    </div>
  </footer>
</body>
</html>
