---
import '../styles/global.css';
import Header from '../components/Header.astro';
import BrandBanner from '../components/BrandBanner.astro';
import Footer from '../components/Footer.astro';
import EntityFacts from '../components/EntityFacts.astro';
import Icon from '../components/Icon.astro';
import { INDEXABLE, business, contentUpdated } from '../data/business.js';
import { buildGraph } from '../lib/schema.js';

const {
  title,
  description,
  crumbs = [],
  faqs = [],
  service = null,
  updated = contentUpdated,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const graph = buildGraph({ canonical, crumbs, faqs, service });
const json = JSON.stringify(graph).replace(/</g, '\\u003c');
const image = `${business.url}/images/og-default.png`;
const whatsapp = business.whatsappIntl ? `https://wa.me/${String(business.whatsappIntl).replace('+', '')}` : '';
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {!INDEXABLE && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0f1e3d" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="en_GB" />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={image} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="No1 Air Conditioning, Ringwood showroom, Hampshire and Dorset" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin />
  {INDEXABLE && <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />}
  <script type="application/ld+json" set:html={json} />
</head>
<body>
  <a class="skip" href="#main-content">Skip to content</a>
  {!INDEXABLE && (
    <p class="preview-bar">Preview site. Pages are set to noindex until INDEXABLE is turned on in the business details.</p>
  )}
  <Header />
  <main id="main-content">
    <slot />
    <EntityFacts updated={updated} />
  </main>
  <BrandBanner headingId="footer-brands" />
  <Footer />
  <div class="float-stack">
    {whatsapp && (
      <a class="float-btn wa" href={whatsapp} aria-label="WhatsApp No1 Air Conditioning">
        <Icon name="quote" size={26} />
      </a>
    )}
    <a class="float-btn" href={`tel:${business.phoneIntl}`} aria-label={`Call ${business.phone}`}>
      <Icon name="phone" size={26} />
    </a>
  </div>
  <script>
    import '../scripts/site.js';
  </script>
</body>
</html>
